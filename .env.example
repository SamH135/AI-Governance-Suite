# Database Configuration
POSTGRES_PASSWORD=your_secure_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# API Key Encryption (must be 32 bytes or 44 base64 chars)
API_KEY_ENCRYPTION_KEY=your_32_byte_encryption_key_here

# Optional: External API Keys (needed to run evals against hosted models)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here
# OpenAI-compatible providers — configure api_url on the model config
GROQ_API_KEY=gsk_your-groq-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
